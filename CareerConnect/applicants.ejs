<!DOCTYPE html>

<html>

<head>

    <title>Applicants - CareerConnect</title>

    <link rel="stylesheet" href="/css/style.css">

</head>


<body>


    <!-- ==============================
         NAVIGATION
    =============================== -->

    <nav>

        <h2>
            CareerConnect
        </h2>

        <div>

            <a href="/">
                Home
            </a>

            <a href="/jobs">
                Jobs
            </a>

            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/company/jobs">
                My Posted Jobs
            </a>

            <a href="/logout">
                Logout
            </a>

        </div>

    </nav>


    <!-- ==============================
         MAIN CONTAINER
    =============================== -->

    <div class="container">


        <h1>
            Applicants
        </h1>


        <p>

            <strong>
                Job:
            </strong>

            <%= job.Title %>

        </p>


        <p>

            <strong>
                Company:
            </strong>

            <%= company.CompanyName %>

        </p>


        <hr>


        <!-- ==============================
             NO APPLICANTS
        =============================== -->

        <% if (applicants.length === 0) { %>


            <div class="job-card">

                <h2>
                    No Applicants Yet
                </h2>

                <p>
                    No students have applied for this job yet.
                </p>

            </div>


        <% } else { %>


            <!-- ==============================
                 APPLICANT LIST
            =============================== -->

            <% applicants.forEach(applicant => { %>


                <div class="job-card">


                    <!-- ==============================
                         STUDENT NAME
                    =============================== -->

                    <h2>

                        <%= applicant.FullName %>

                    </h2>


                    <!-- ==============================
                         EMAIL
                    =============================== -->

                    <p>

                        <strong>
                            Email:
                        </strong>

                        <%= applicant.Email %>

                    </p>


                    <!-- ==============================
                         PHONE
                    =============================== -->

                    <p>

                        <strong>
                            Phone:
                        </strong>

                        <%= applicant.Phone || "Not provided" %>

                    </p>


                    <!-- ==============================
                         COLLEGE
                    =============================== -->

                    <p>

                        <strong>
                            College:
                        </strong>

                        <%= applicant.College || "Not provided" %>

                    </p>


                    <!-- ==============================
                         COURSE
                    =============================== -->

                    <p>

                        <strong>
                            Course:
                        </strong>

                        <%= applicant.Course || "Not provided" %>

                    </p>


                    <!-- ==============================
                         EDUCATION
                    =============================== -->

                    <p>

                        <strong>
                            Education:
                        </strong>

                        <%= applicant.Education || "Not provided" %>

                    </p>


                    <!-- ==============================
                         SKILLS
                    =============================== -->

                    <p>

                        <strong>
                            Skills:
                        </strong>

                        <%= applicant.Skills || "Not provided" %>

                    </p>


                    <!-- ==============================
                         APPLICATION DATE
                    =============================== -->

                    <p>

                        <strong>
                            Application Date:
                        </strong>

                        <%= new Date(
                            applicant.ApplicationDate
                        ).toLocaleString() %>

                    </p>


                    <!-- ==============================
                         RESUME
                    =============================== -->

                    <p>

                        <strong>
                            Resume:
                        </strong>


                        <% if (applicant.ResumePath) { %>

                            <a
                                href="<%= applicant.ResumePath %>"
                                target="_blank"
                                style="
                                    color:#6D3B6D;
                                    font-weight:bold;
                                    text-decoration:none;
                                "
                            >
                                View Resume
                            </a>

                        <% } else { %>

                            <span>
                                Not uploaded
                            </span>

                        <% } %>

                    </p>


                    <!-- ==============================
                         STATUS
                    =============================== -->

                    <p>

                        <strong>
                            Status:
                        </strong>

                        <%= applicant.Status %>

                    </p>


                    <hr>


                    <!-- ==============================
                         ACCEPT / REJECT
                    =============================== -->

                    <div class="dashboard-actions">


                        <!-- ACCEPT -->

                        <form
                            action="/company/applicants/<%= applicant.ApplicationId %>/status"
                            method="POST"
                        >

                            <input
                                type="hidden"
                                name="status"
                                value="Accepted"
                            >

                            <button type="submit">

                                Accept

                            </button>

                        </form>


                        <!-- REJECT -->

                        <form
                            action="/company/applicants/<%= applicant.ApplicationId %>/status"
                            method="POST"
                        >

                            <input
                                type="hidden"
                                name="status"
                                value="Rejected"
                            >

                            <button type="submit">

                                Reject

                            </button>

                        </form>


                    </div>


                </div>


            <% }) %>


        <% } %>


    </div>


</body>

</html>