<!DOCTYPE html>

<html>

<head>

    <title>My Profile - CareerConnect</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <nav>

        <h2>CareerConnect</h2>

        <div>

            <a href="/">
                Home
            </a>

            <a href="/jobs">
                Jobs
            </a>

            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/profile">
                My Profile
            </a>

            <a href="/applications">
                My Applications
            </a>

            <a href="/logout">
                Logout
            </a>

        </div>

    </nav>


    <div class="form-container">

        <h1>
            My Profile
        </h1>

        <p>
            Complete your profile to help companies
            understand your education, skills and experience.
        </p>

        <hr>


        <form
            action="/profile"
            method="POST"
            enctype="multipart/form-data"
        >


            <!-- FULL NAME -->

            <label>
                Full Name
            </label>

            <input
                type="text"
                name="fullName"
                value="<%= user.fullName %>"
                required
            >


            <!-- EMAIL -->

            <label>
                Email
            </label>

            <input
                type="email"
                value="<%= user.email %>"
                disabled
            >


            <!-- PHONE -->

            <label>
                Phone
            </label>

            <input
                type="text"
                name="phone"
                value="<%= profile ? (profile.Phone || '') : '' %>"
                placeholder="Enter your phone number"
            >


            <!-- COLLEGE -->

            <label>
                College
            </label>

            <input
                type="text"
                name="college"
                value="<%= profile ? (profile.College || '') : '' %>"
                placeholder="Enter your college name"
            >


            <!-- COURSE -->

            <label>
                Course
            </label>

            <input
                type="text"
                name="course"
                value="<%= profile ? (profile.Course || '') : '' %>"
                placeholder="Example: B.Tech Computer Science"
            >


            <!-- EDUCATION -->

            <label>
                Education
            </label>

            <input
                type="text"
                name="education"
                value="<%= profile ? (profile.Education || '') : '' %>"
                placeholder="Example: B.Tech - Computer Science"
            >


            <!-- SKILLS -->

            <label>
                Skills
            </label>

            <input
                type="text"
                name="skills"
                value="<%= profile ? (profile.Skills || '') : '' %>"
                placeholder="Example: HTML, CSS, JavaScript, Node.js, SQL"
            >


            <!-- RESUME -->

            <label>
                Resume
            </label>

            <input
                type="file"
                name="resume"
                accept=".pdf"
            >

            <p style="font-size:13px; color:#756875;">
                Upload your resume in PDF format.
            </p>


            <!-- VIEW EXISTING RESUME -->

            <% if (profile && profile.ResumePath) { %>

                <div
                    style="
                        margin-top:15px;
                        padding:15px;
                        background:#F3D7E3;
                        border-radius:8px;
                    "
                >

                    <strong>
                        Resume Uploaded:
                    </strong>

                    <a
                        href="<%= profile.ResumePath %>"
                        target="_blank"
                        style="
                            margin-left:10px;
                            color:#6D3B6D;
                            font-weight:bold;
                        "
                    >
                        View Resume
                    </a>

                </div>

            <% } %>


            <br>
            <br>


            <button type="submit">
                Save Profile
            </button>


        </form>

    </div>


</body>

</html>