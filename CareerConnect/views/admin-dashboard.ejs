<!DOCTYPE html>

<html>

<head>

    <title>Admin Dashboard - CareerConnect</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <nav>

        <h2>
            CareerConnect
        </h2>

        <div>

            <a href="/">
                Home
            </a>

            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/logout">
                Logout
            </a>

        </div>

    </nav>


    <div class="form-container">


        <h1>
            Welcome, Admin!
        </h1>


        <p>
            Welcome to the CareerConnect Admin Dashboard.
        </p>


        <hr>


        <h2>
            Admin Dashboard
        </h2>


        <p>
            From here you can manage students,
            companies, jobs and applications.
        </p>


        <div class="student-info">


            <div class="student-card">

                <h3>
                    TOTAL STUDENTS
                </h3>

                <p>
                    0
                </p>

            </div>


            <div class="student-card">

                <h3>
                    TOTAL COMPANIES
                </h3>

                <p>
                    0
                </p>

            </div>


            <div class="student-card">

                <h3>
                    TOTAL JOBS
                </h3>

                <p>
                    0
                </p>

            </div>


            <div class="student-card">

                <h3>
                    TOTAL APPLICATIONS
                </h3>

                <p>
                    0
                </p>

            </div>


        </div>


        <hr>


        <h2>
            Admin Actions
        </h2>


        <div class="dashboard-actions">


            <a href="/admin/students">

                <button type="button">
                    Manage Students
                </button>

            </a>


            <a href="/admin/companies">

                <button type="button">
                    Manage Companies
                </button>

            </a>


            <a href="/admin/jobs">

                <button type="button">
                    Manage Jobs
                </button>

            </a>


            <a href="/admin/applications">

                <button type="button">
                    Manage Applications
                </button>

            </a>


        </div>


    </div>


</body>

</html>