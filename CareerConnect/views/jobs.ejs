<!DOCTYPE html>
<html>

<head>

    <title>Jobs - CareerConnect</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

    <!-- Navigation Bar -->

    <nav>

        <h2>CareerConnect</h2>

        <div>

            <a href="/">Home</a>

            <a href="/jobs">Jobs</a>

            <a href="/login">Login</a>

            <a href="/register">Register</a>

        </div>

    </nav>


    <!-- Jobs Section -->

    <div class="container">

        <h1>Available Jobs & Internships</h1>


        <!-- Display jobs from SQL Server -->

        <% jobs.forEach(job => { %>

            <div class="job-card">

                <h2>
                    <%= job.Title %>
                </h2>

                <p>
                    <strong>Company:</strong>
                    <%= job.Company %>
                </p>

                <p>
                    <strong>Location:</strong>
                    <%= job.Location %>
                </p>

                <p>
                    <strong>Job Type:</strong>
                    <%= job.JobType %>
                </p>

                <p>
                    <strong>Description:</strong>
                    <%= job.Description %>
                </p>

                <p>
                    <strong>Skills:</strong>
                    <%= job.Skills %>
                </p>

                <p>
                    <strong>Salary:</strong>
                    <%= job.Salary %>
                </p>

                <form action="/apply/<%= job.JobId %>" method="POST">

    <button type="submit">
        Apply Now
    </button>

</form>

            </div>

        <% }) %>


    </div>

</body>

</html>