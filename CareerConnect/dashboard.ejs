<!DOCTYPE html>
<html>

<head>

    <title>Student Dashboard - CareerConnect</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>


    <nav>

        <h2>CareerConnect</h2>

        <div>

            <a href="/">Home</a>

            <a href="/jobs">Jobs</a>

            <a href="/dashboard">Dashboard</a>

            <a href="/profile">Profile</a>

            <a href="/logout">Logout</a>

        </div>

    </nav>


    <div class="form-container">



        <h1>
            Welcome, <%= user.fullName %>!
        </h1>


        <p>
            Welcome to your CareerConnect student dashboard.
        </p>


        <hr>


        <h2>
            Student Dashboard
        </h2>


        <p>
            From here you can browse jobs and internships,
            apply for opportunities, and track your applications.
        </p>


        <div class="student-info">



            <div class="student-card">

                <h3>
                    FULL NAME
                </h3>

                <p>
                    <%= user.fullName %>
                </p>

            </div>



            <div class="student-card">

                <h3>
                    EMAIL
                </h3>

                <p>
                    <%= user.email %>
                </p>

            </div>



            <div class="student-card">

                <h3>
                    ROLE
                </h3>

                <p>
                    <%= user.role %>
                </p>

            </div>


        </div>


        <div class="dashboard-actions">



            <a href="/jobs">

                <button type="button">
                    Browse Jobs
                </button>

            </a>



            <a href="/applications">

                <button type="button">
                    My Applications
                </button>

            </a>


        </div>


    </div>


</body>

</html>