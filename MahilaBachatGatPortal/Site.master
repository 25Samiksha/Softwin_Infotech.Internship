<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>

<script>

    $(document).ready(function () {

        $(".sidebar-dropdown").each(function () {

            var target = $(this).attr("data-target");

            if (target &&
               localStorage.getItem("sidebar_" + target) === "open") {

                $(target).addClass("in").css("height", "auto");

            }

        });

        $(".sidebar-dropdown").on("click", function (e) {

            e.preventDefault();
            e.stopPropagation();

            var target = $(this).attr("data-target");

            if (!target) {
                return;
            }

            var menu = $(target);

            if (menu.hasClass("in")) {

                menu.removeClass("in").css("height", "0");

                localStorage.removeItem("sidebar_" + target);

            }
            else {

                menu.addClass("in").css("height", "auto");

                localStorage.setItem("sidebar_" + target, "open");

            }

        });

    });

</script>

</form>

