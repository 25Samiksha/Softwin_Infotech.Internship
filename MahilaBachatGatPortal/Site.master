<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html>
<head id="Head1" runat="server">
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Mahila Bachat Gat Management Portal</title>

<link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
<link href="CSS/style.css" rel="stylesheet" />

<style>

.navbar-header{
    padding-left:10px !important;
}

.logo-brand{
    display:flex !important;
    align-items:center !important;
    justify-content:flex-start !important;
    height:64px !important;
    padding:5px 14px !important;
    margin:0 !important;
    color:#3D1F2D !important;
    text-decoration:none !important;
    overflow:visible !important;
    gap:10px;
}

.logo-brand:hover,
.logo-brand:focus{
    background:transparent !important;
    color:#3D1F2D !important;
    text-decoration:none !important;
}

.site-logo{
    display:block !important;
    width:auto !important;
    height:46px !important;
    min-width:0 !important;
    max-width:180px !important;
    margin:0 !important;
    padding:4px !important;
    object-fit:contain !important;
    border-radius:8px !important;
    background:rgba(255,255,255,.35) !important;
}

.top-navbar{
    background:#F8E8E8 !important;
    border:none !important;
    min-height:64px !important;
    margin-bottom:0 !important;
    box-shadow:0 2px 10px rgba(61,31,45,.08) !important;
}

.top-navbar .navbar-nav > li > a{
    color:#3D1F2D !important;
    font-weight:600 !important;
}

.top-navbar .navbar-nav > li > a:hover,
.top-navbar .navbar-nav > li > a:focus{
    background:#F8E8EC !important;
    color:#9E2D4A !important;
}

.navbar-right > li > a .glyphicon{
    color:#C0395B !important;
}

.navbar-toggle{
    border-color:#C0395B !important;
    background:#F8E8E8 !important;
}

.navbar-toggle:hover,
.navbar-toggle:focus{
    background:#F8E8EC !important;
}

.navbar-toggle .icon-bar{
    background:#C0395B !important;
}

.sidebar{
    background:#F2D7DE !important;
    border:none !important;
    min-height:calc(100vh - 64px) !important;
    padding-top:20px !important;
    box-shadow:2px 0 8px rgba(61,31,45,.05) !important;
}

.sidebar .nav{
    margin-bottom:0 !important;
}

.sidebar .nav > li > a{
    color:#3D1F2D !important;
    background:transparent !important;
    border-radius:6px !important;
    font-weight:500 !important;
    padding:14px 18px !important;
    margin:2px 10px !important;
    transition:all .2s ease !important;
}

.sidebar .nav > li > a:hover,
.sidebar .nav > li > a:focus{
    background:#F8E8EC !important;
    color:#9E2D4A !important;
}

.sidebar .nav > li > a .glyphicon{
    color:#C0395B !important;
    margin-right:12px !important;
}

.sidebar-title{
    color:#754B5A !important;
    font-size:11px !important;
    font-weight:700 !important;
    letter-spacing:1px !important;
    padding:15px 20px 10px !important;
    margin-top:5px !important;
    border-radius:6px !important;
}

.dropdown-title{
    cursor:pointer !important;
    transition:all .2s ease !important;
}

.dropdown-title:hover{
    color:#9E2D4A !important;
}

.sidebar-dropdown{
    border-left:3px solid transparent !important;
    margin:0 10px !important;
    border-radius:6px !important;
    transition:all .2s ease !important;
}

.sidebar-dropdown:hover{
    border-left:3px solid #C0395B !important;
    background:#EBC1CC !important;
}

.sidebar-submenu{
    background:#F2D7DE !important;
    padding:4px 0 8px 0 !important;
    margin:0 !important;
    list-style:none !important;
}

.sidebar-submenu li{
    list-style:none !important;
}

.sidebar-submenu li a{
    display:block !important;
    color:#3D1F2D !important;
    background:transparent !important;
    padding:12px 18px 12px 40px !important;
    margin:2px 10px !important;
    border-radius:6px !important;
    text-decoration:none !important;
    font-weight:500 !important;
    transition:all .2s ease !important;
}

.sidebar-submenu li a:hover,
.sidebar-submenu li a:focus{
    background:#F8E8EC !important;
    color:#9E2D4A !important;
}

.sidebar-submenu li a .glyphicon{
    color:#C0395B !important;
    margin-right:12px !important;
}

.sidebar-submenu li.active > a,
.sidebar-submenu li > a.active{
    background:#FFFFFF !important;
    color:#C0395B !important;
    font-weight:600 !important;
    box-shadow:0 2px 6px rgba(61,31,45,.05) !important;
}

.sidebar-submenu li.active > a .glyphicon,
.sidebar-submenu li > a.active .glyphicon{
    color:#C0395B !important;
}

.main-content{
    background:#FDF7F2 !important;
    min-height:calc(100vh - 64px) !important;
    padding:25px !important;
}

.navbar-right{
    margin-right:10px !important;
}

.navbar-right > li > a{
    color:#3D1F2D !important;
}

.navbar-right > li > a:hover{
    background:#F8E8EC !important;
    color:#9E2D4A !important;
}

.navbar-right > li > a .glyphicon{
    color:#C0395B !important;
}

@media(max-width:767px){

    .navbar-header{
        padding-left:5px !important;
    }

    .logo-brand{
        height:55px !important;
        padding:4px 8px !important;
    }

    .site-logo{
        height:40px !important;
    }

    .top-navbar{
        min-height:55px !important;
    }

    .sidebar{
        min-height:auto !important;
        padding-top:10px !important;
    }

    .main-content{
        padding:15px !important;
    }

    .navbar-right{
        margin-right:0 !important;
    }

}

</style>

<asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

